      "asset": "audio/nuit-01-p03-fr-ps-99c6a14d8864.m4a",
      "audioHash": "99c6a14d8864c1c974268c3aaecf0c6b707979591432c25b99d8170fad319d35",
      "durationMs": 51236,
      "sourceHash": "4b5846b48d6fba8bd876b7b30ab3be972080ca65b7423ef7aa0f1cb842d901d3",
